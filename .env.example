# Copy to .env for local development. See docs/prd/PRD-00-architecture.md section 8.

# GitLab connection
GITLAB_BASE_URL=https://gitlab.com/api/v4
GITLAB_TOKEN=
GITLAB_CA_BUNDLE=
GITLAB_SKIP_TLS_VERIFY=false

# Tool surface
GITLAB_MCP_TOOLSETS=
GITLAB_MCP_READ_ONLY=false

# Sessions
MCP_SESSION_IDLE_TIMEOUT=1800
MCP_MAX_SESSIONS=100

# Listener (put TLS termination in front of this; see PRD-00 section 9)
MCP_BIND_HOST=127.0.0.1
MCP_BIND_PORT=8080
