# Copy to .env for local development. Every variable is optional; see
# docs/prd/PRD-00-architecture.md section 8 for defaults and meaning.
#
# There is deliberately no GITLAB_TOKEN: the server is shared, so each client
# sends its own PAT on every request (Authorization: Bearer <PAT>).

# GitLab connection
GITLAB_BASE_URL=https://gitlab.com/api/v4
GITLAB_CA_BUNDLE=
GITLAB_SKIP_TLS_VERIFY=false
GITLAB_TIMEOUT_SECONDS=30
GITLAB_MAX_RETRIES=3
GITLAB_MAX_RESPONSE_BYTES=10485760

# Tool surface (empty toolsets = each toolset's default)
GITLAB_MCP_TOOLSETS=
GITLAB_MCP_READ_ONLY=false
GITLAB_MCP_MAX_FILE_BYTES=1048576

# Streamable HTTP. Stateless by default; the two session settings apply only
# when MCP_STATELESS_HTTP=false. Responses are SSE streams unless
# MCP_JSON_RESPONSE=true, which answers each request with one JSON body.
MCP_STATELESS_HTTP=true
MCP_JSON_RESPONSE=false
# Largest request body accepted from a client, in bytes; larger ones get 413.
MCP_MAX_REQUEST_BYTES=10485760
MCP_SESSION_IDLE_TIMEOUT=1800
MCP_MAX_SESSIONS=

# Listener. A non-loopback MCP_BIND_HOST also needs MCP_ALLOWED_HOSTS and TLS:
# MCP_TLS_CERTFILE + MCP_TLS_KEYFILE, or MCP_TLS_TERMINATED_UPSTREAM=true when a
# reverse proxy terminates TLS in front (see PRD-00 section 9).
MCP_BIND_HOST=127.0.0.1
MCP_BIND_PORT=8080
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_TLS_CERTFILE=
MCP_TLS_KEYFILE=
MCP_TLS_TERMINATED_UPSTREAM=false

# Logging: DEBUG, INFO, WARNING, or ERROR; json or text
LOG_LEVEL=INFO
LOG_FORMAT=json
